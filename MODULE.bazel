module(
    name = "rules_nogo",
    version = "0.1.0",
    compatibility_level = 1,
)

bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "gazelle", version = "0.42.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1", dev_dependency = True)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")

# Pin the SDK archives so rules_go never fetches the unhashed go.dev/dl JSON
# index to discover them. Hashes are from go.dev/dl, cross-checked against
# dl.google.com/go/<file>.sha256; bump them together with the version.
go_sdk.download(
    sdks = {
        "darwin_amd64": [
            "go1.26.2.darwin-amd64.tar.gz",
            "bc3f1500d9968c36d705442d90ba91addf9271665033748b82532682e90a7966",
        ],
        "darwin_arm64": [
            "go1.26.2.darwin-arm64.tar.gz",
            "32af1522bf3e3ff3975864780a429cc0b41d190ec7bf90faa661d6d64566e7af",
        ],
        "linux_amd64": [
            "go1.26.2.linux-amd64.tar.gz",
            "990e6b4bbba816dc3ee129eaeaf4b42f17c2800b88a2166c265ac1a200262282",
        ],
        "linux_arm64": [
            "go1.26.2.linux-arm64.tar.gz",
            "c958a1fe1b361391db163a485e21f5f228142d6f8b584f6bef89b26f66dc5b23",
        ],
        "windows_amd64": [
            "go1.26.2.windows-amd64.zip",
            "98eb3570bade15cb826b0909338df6cc6d2cf590bc39c471142002db3832b708",
        ],
    },
    version = "1.26.2",
)
use_repo(go_sdk, "go_toolchains")

register_toolchains("@go_toolchains//:all")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    # Direct analyzer deps
    "co_honnef_go_tools",
    "com_github_gordonklaus_ineffassign",
    "com_github_kisielk_errcheck",
    "com_github_nishanths_exhaustive",
    "com_github_sonatard_noctx",
    "com_github_timakin_bodyclose",
    "org_golang_x_tools",
    "org_uber_go_nilaway",
)
