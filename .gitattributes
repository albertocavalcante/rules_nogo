# Auto-detect text files and normalize line endings
* text=auto

# Go
*.go text diff=golang
go.sum text -diff linguist-generated

# Starlark / Bazel
*.bzl text diff=python
*.bazel text diff=python
MODULE.bazel text diff=python
MODULE.bazel.lock text -diff linguist-generated

# Patches
*.patch text diff

# Documentation
*.md text diff=markdown

# Deny large binaries
*.exe binary
*.dll binary
*.so binary
*.dylib binary
