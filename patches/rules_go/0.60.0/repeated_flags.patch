 // IsWarning returns true when the analyzer severity is set to "warning".
 func (c Config) IsWarning() bool {
 	return c.Severity == "warning"
 }
+
+// UnmarshalJSON implements json.Unmarshaler for Config, allowing analyzer_flags
+// values to be either a JSON string or a JSON array of strings.
+func (c *Config) UnmarshalJSON(data []byte) error {
+	// Use an alias to avoid infinite recursion.
+	type configAlias struct {
+		Description   string                     `json:"description"`
+		Severity      string                     `json:"severity"`
+		OnlyFiles     map[string]string          `json:"only_files"`
+		ExcludeFiles  map[string]string          `json:"exclude_files"`
+		AnalyzerFlags map[string]json.RawMessage `json:"analyzer_flags"`
+	}
+	var alias configAlias
+	if err := json.Unmarshal(data, &alias); err != nil {
+		return err
+	}
+	c.Description = alias.Description
+	c.Severity = alias.Severity
+	c.OnlyFiles = alias.OnlyFiles
+	c.ExcludeFiles = alias.ExcludeFiles
+
+	if len(alias.AnalyzerFlags) == 0 {
+		return nil
+	}
+	c.AnalyzerFlags = make(map[string][]string, len(alias.AnalyzerFlags))
+	for key, raw := range alias.AnalyzerFlags {
+		// Try string first.
+		var s string
+		if err := json.Unmarshal(raw, &s); err == nil {
+			c.AnalyzerFlags[key] = []string{s}
+			continue
+		}
+		// Try array of strings.
+		var ss []string
+		if err := json.Unmarshal(raw, &ss); err != nil {
+			return fmt.Errorf("analyzer_flags[%q]: expected string or []string, got %s", key, raw)
+		}
+		c.AnalyzerFlags[key] = ss
+	}
+	return nil
+}
