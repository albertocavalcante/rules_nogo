# repeated_flags.patch — allows analyzer_flags values to be JSON arrays
# Patch for rules_go 0.60.0
# IMPORTANT: This patch must be applied AFTER warning_mode.patch.
# In archive_override patches=[], order is sequential — list warning_mode first.
# Generated by rules_nogo
#
# Allows analyzer_flags values to be a JSON string or a JSON array of
# strings. When an array is given, flag.Set() is called once per value,
# enabling analyzers that register repeated flags (e.g. importas --alias).
#
# Config format extension:
#   "importas": {
#     "analyzer_flags": {
#       "alias": ["k8s.io/api/core/v1:corev1", "k8s.io/api/apps/v1:appsv1"]
#     }
#   }
# Single-string values continue to work as before.
#
# Files modified:
#   go/tools/builders/generate_nogo_main.go — Config.AnalyzerFlags []string + UnmarshalJSON
#   go/tools/builders/nogo_main.go          — setAnalyzerFlags loops over []string
--- a/go/tools/builders/generate_nogo_main.go	2026-04-19 16:28:09
+++ b/go/tools/builders/generate_nogo_main.go	2026-04-19 16:28:31
@@ -58,9 +58,13 @@
